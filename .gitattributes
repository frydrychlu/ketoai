# Normalize line endings: store LF in the repo, check out LF in the working tree
# on every platform. Ends the CRLF-vs-Prettier(LF) lint churn on Windows.
* text=auto eol=lf

# Binary assets — never normalize.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
