---
import Layout from "@/layouts/Layout.astro";
import MealLogger from "@/components/meals/MealLogger";
import ActivityLogger from "@/components/activities/ActivityLogger";
import BiomarkerLogger from "@/components/biomarkers/BiomarkerLogger";
import WellnessLogger from "@/components/wellness/WellnessLogger";

const { user } = Astro.locals;
---

<Layout title="Dashboard">
  <div class="bg-cosmic min-h-screen p-4">
    <div class="mx-auto max-w-2xl">
      <header class="mb-6 flex items-center justify-between">
        <div>
          <h1 class="bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-2xl font-bold text-transparent">
            KetoAI
          </h1>
          <p class="text-sm text-blue-100/60">{user?.email}</p>
        </div>
        <div class="flex items-center gap-2">
          <a
            href="/profile"
            class="rounded-lg border border-white/20 bg-white/10 px-3 py-2 text-sm text-white transition-colors hover:bg-white/20"
          >
            Profile
          </a>
          <form method="POST" action="/api/auth/signout">
            <button
              type="submit"
              class="rounded-lg border border-white/20 bg-white/10 px-3 py-2 text-sm text-white transition-colors hover:bg-white/20"
            >
              Sign out
            </button>
          </form>
        </div>
      </header>
      <div class="rounded-2xl border border-white/10 bg-white/10 p-6 backdrop-blur-xl">
        <MealLogger client:load />
        <hr class="my-6 border-white/10" />
        <h2 class="mb-4 text-sm font-semibold tracking-wide text-blue-100/70 uppercase">Activity</h2>
        <ActivityLogger client:load />
        <div class="mt-8 border-t border-white/10 pt-6">
          <h2 class="mb-4 text-sm font-semibold tracking-wide text-blue-100/70 uppercase">Biomarkers</h2>
          <BiomarkerLogger client:load />
        </div>
        <div class="mt-8 border-t border-white/10 pt-6">
          <h2 class="mb-4 text-sm font-semibold tracking-wide text-blue-100/70 uppercase">Wellness</h2>
          <WellnessLogger client:load />
        </div>
      </div>
    </div>
  </div>
</Layout>
